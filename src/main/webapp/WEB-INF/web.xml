<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <display-name>Recipe Recommender</display-name>

    <servlet>
        <servlet-name>HomeServlet</servlet-name>
        <servlet-class>com.seweb.servlet.HomeServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>HomeServlet</servlet-name>
        <url-pattern>/</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>RecipesServlet</servlet-name>
        <servlet-class>com.seweb.servlet.RecipesServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>RecipesServlet</servlet-name>
        <url-pattern>/recipes</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>AddRecipeServlet</servlet-name>
        <servlet-class>com.seweb.servlet.AddRecipeServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AddRecipeServlet</servlet-name>
        <url-pattern>/add-recipe</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>AddUserServlet</servlet-name>
        <servlet-class>com.seweb.servlet.AddUserServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AddUserServlet</servlet-name>
        <url-pattern>/add-user</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>RecommendSkillServlet</servlet-name>
        <servlet-class>com.seweb.servlet.RecommendSkillServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>RecommendSkillServlet</servlet-name>
        <url-pattern>/recommend-skill</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>RecommendSkillCuisineServlet</servlet-name>
        <servlet-class>com.seweb.servlet.RecommendSkillCuisineServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>RecommendSkillCuisineServlet</servlet-name>
        <url-pattern>/recommend-skill-cuisine</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>RecipeDetailServlet</servlet-name>
        <servlet-class>com.seweb.servlet.RecipeDetailServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>RecipeDetailServlet</servlet-name>
        <url-pattern>/recipe-detail</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>FilterCuisineServlet</servlet-name>
        <servlet-class>com.seweb.servlet.FilterCuisineServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>FilterCuisineServlet</servlet-name>
        <url-pattern>/filter-cuisine</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>XSLDisplayServlet</servlet-name>
        <servlet-class>com.seweb.servlet.XSLDisplayServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>XSLDisplayServlet</servlet-name>
        <url-pattern>/xsl-display</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ScrapeServlet</servlet-name>
        <servlet-class>com.seweb.servlet.ScrapeServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ScrapeServlet</servlet-name>
        <url-pattern>/scrape</url-pattern>
    </servlet-mapping>

</web-app>
